# Application
APP_NAME="Tiffin Tracker API"
DEBUG=true

# Database — Railway provides this automatically in production
# Format: mysql+aiomysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/tiffin_tracker

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

# Access token lifetime (short-lived; refresh token handles long sessions)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Session / refresh token — sliding window: resets on each use
SESSION_LIFETIME_DAYS=30
REFRESH_TOKEN_ROTATION_ENABLED=true

# Cookie — set COOKIE_SECURE=false for local HTTP dev; true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Google OAuth — from console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web Application type)
# Authorized origins: http://localhost:5173
# Authorized redirect URIs: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# Razorpay — from razorpay.com/dashboard (Week 3)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
